<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/itemproductos"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF"
    android:clickable="true"
    android:focusable="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardImageContainer"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintDimensionRatio="1:1"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F5F5F5"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                                <ImageView
                                    android:id="@+id/imageItemProducto"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    app:srcCompat="@drawable/agregar_imgaen" />

                                <!-- Etiqueta flotante de Condición -->
                                <TextView
                                    android:id="@+id/condicionItemProducto"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="top|start"
                                    android:layout_margin="6dp"
                                    android:background="#E8F5E9"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="2dp"
                                    android:textColor="#2E7D32"
                                    android:textSize="8sp"
                                    android:textStyle="bold"
                                    android:visibility="gone"
                                    tools:text="Nuevo" />

                                <!-- Etiqueta flotante de Calidad -->
                                <TextView
                                    android:id="@+id/calidadItemProducto"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="top|end"
                                    android:layout_margin="6dp"
                                    android:background="#E3F2FD"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="2dp"
                                    android:textColor="#1565C0"
                                    android:textSize="8sp"
                                    android:textStyle="bold"
                                    android:visibility="gone"
                                    tools:text="OLED" />
                        </FrameLayout>
                </androidx.cardview.widget.CardView>

                <!-- Sección / Categoría -->
                <TextView
                    android:id="@+id/secciontxt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textAllCaps="true"
                    android:textColor="#1976D2"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cardImageContainer"
                    tools:text="PANTALLAS" />

                <!-- Fila Marca y Modelo -->
                <LinearLayout
                    android:id="@+id/containerMarcaModelo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/secciontxt">

                        <TextView
                            android:id="@+id/marcaItemProducto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#616161"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            tools:text="Samsung" />

                        <TextView
                            android:id="@+id/modeloItemProducto"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:textColor="#9E9E9E"
                            android:textSize="9sp"
                            tools:text="• A54 5G" />
                </LinearLayout>

                <!-- Nombre -->
                <TextView
                    android:id="@+id/nombretxt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:minLines="2"
                    android:textColor="#212121"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/containerMarcaModelo"
                    tools:text="Pantalla Completa c/ Marco" />

                <!-- Compatibilidad -->
                <TextView
                    android:id="@+id/compatiblesItemProducto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="#757575"
                    android:textSize="8sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/nombretxt"
                    tools:text="Compat: A34, A54" />

                <!-- Fila Código y Precio -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/compatiblesItemProducto">

                        <TextView
                            android:id="@+id/codigoBarralbl"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:textColor="#BDBDBD"
                            android:textSize="8sp"
                            tools:text="123456" />

                        <TextView
                            android:id="@+id/preciotxt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#2E7D32"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="$1,200" />
                </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>